
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Legal - Chat Dashboard</title>
  <meta name="csrf-token" content="{{ csrf_token }}">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --whatsapp-green: #25D366;
      --whatsapp-dark: #075E54;
      --whatsapp-teal: #128C7E;
      --chat-bg: #E5DDD5;
      --sent-bubble: #DCF8C6;
      --received-bubble: #FFFFFF;
      --sidebar-bg: #F0F2F5;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--chat-bg);
      height: 100vh;
      overflow: hidden;
    }

    .chat-container {
      display: flex;
      height: 100vh;
      background: var(--sidebar-bg);
      overflow: hidden;
    }

    .sidebar {
      width: 380px;
      background: white;
      border-right: 1px solid #e9ecef;
      display: flex;
      flex-direction: column;
      height: 100vh;
      transition: transform 0.3s ease;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      .sidebar {
        width: 100%;
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        transform: translateX(0);
      }
      .sidebar.hide {
        transform: translateX(-100%);
      }
      .chat-area {
        width: 100%;
      }
    }

    .sidebar-header {
      padding: 16px;
      background: var(--whatsapp-dark);
      color: white;
      flex-shrink: 0;
    }

    .sidebar-header h4 {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
    }

    .search-box {
      padding: 12px;
      background: white;
      border-bottom: 1px solid #e9ecef;
      flex-shrink: 0;
    }

    .search-box input {
      width: 100%;
      padding: 10px 16px;
      border: none;
      background: var(--sidebar-bg);
      border-radius: 20px;
      font-size: 14px;
      outline: none;
    }

    .chat-tabs {
      display: flex;
      background: white;
      border-bottom: 1px solid #e9ecef;
      padding: 0 16px;
      gap: 24px;
    }

    .chat-tab {
      padding: 12px 0;
      font-size: 15px;
      font-weight: 500;
      color: #667781;
      cursor: pointer;
      position: relative;
      transition: all 0.2s;
    }

    .chat-tab.active {
      color: var(--whatsapp-green);
    }

    .chat-tab.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--whatsapp-green);
      border-radius: 3px;
    }

    .chat-tab:hover {
      color: var(--whatsapp-dark);
    }

    .chat-tab .badge {
      background: #dc3545;
      color: white;
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 12px;
      margin-left: 6px;
    }

    .contact-list {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
    }

    .contact-item {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      cursor: pointer;
      transition: background 0.2s;
      border-bottom: 1px solid #f0f0f0;
    }

    .contact-item:hover {
      background: #f5f5f5;
    }

    .contact-item.active {
      background: #ebf5ff;
    }

    .contact-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--whatsapp-green);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 18px;
      margin-right: 12px;
      flex-shrink: 0;
    }

    .contact-info {
      flex: 1;
      min-width: 0;
    }

    .contact-name {
      font-weight: 600;
      font-size: 15px;
      margin-bottom: 4px;
      color: #111;
    }

    .contact-last-msg {
      font-size: 13px;
      color: #667781;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .contact-meta {
      text-align: right;
      flex-shrink: 0;
    }

    .contact-time {
      font-size: 11px;
      color: #667781;
      margin-bottom: 4px;
    }

    .unread-badge {
      background: var(--whatsapp-green);
      color: white;
      border-radius: 20px;
      padding: 2px 8px;
      font-size: 11px;
      font-weight: 600;
    }

    .contacts-loading {
      text-align: center;
      padding: 20px;
      color: #667781;
      font-size: 13px;
    }

    .contacts-loading i {
      margin-right: 8px;
    }

    .chat-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--chat-bg);
      height: 100vh;
      overflow: hidden;
    }

    .chat-header {
      background: white;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid #e9ecef;
      flex-shrink: 0;
    }

    .chat-header-back {
      display: none;
      background: none;
      border: none;
      font-size: 20px;
      margin-right: 12px;
      cursor: pointer;
      padding: 8px;
      border-radius: 50%;
    }

    @media (max-width: 768px) {
      .chat-header-back {
        display: block;
      }
    }

    .chat-header-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--whatsapp-green);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      margin-right: 12px;
      flex-shrink: 0;
    }

    .chat-header-info {
      flex: 1;
    }

    .chat-header-name {
      font-weight: 600;
      font-size: 16px;
      margin-bottom: 2px;
    }

    .chat-header-status {
      font-size: 12px;
      color: #667781;
    }

    .messages-container {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .message-row {
      display: flex;
      width: 100%;
      margin-bottom: 4px;
    }

    .message-row.sent {
      justify-content: flex-end;
    }

    .message-row.received {
      justify-content: flex-start;
    }

    /* .message-bubble {
      max-width: 70%;
      min-width: 60px;
      padding: 8px 12px;
      border-radius: 12px;
      word-wrap: break-word;
      word-break: break-word;

    } */
     .message-bubble {
    max-width: 70%;
    min-width: 60px;
    padding: 8px 12px;
    border-radius: 12px;
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: break-word;
    overflow: hidden; /* Prevents overflow */
}

    .message-bubble.sent {
      background: var(--sent-bubble);
      border-bottom-right-radius: 4px;
    }

    .message-bubble.received {
      background: var(--received-bubble);
      border-bottom-left-radius: 4px;
    }

    .message-text {
      font-size: 14px;
      line-height: 1.4;
      color: #111;
    }

    .message-meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      margin-top: 4px;
      font-size: 10px;
      color: #667781;
    }

    .message-time {
      font-size: 10px;
    }

    .message-tick {
      font-size: 12px;
      margin-left: 4px;
      display: inline-block;
    }

    .message-tick.sent { color: #8696a0; }
    .message-tick.delivered { color: #8696a0; }
    .message-tick.read { color: #34B7F1; }

    .message-image {
      max-width: 250px;
      max-height: 250px;
      border-radius: 8px;
      cursor: pointer;
      display: block;
    }

    .message-video {
      max-width: 250px;
      border-radius: 8px;
      cursor: pointer;
      display: block;
    }

    .message-audio {
      width: 250px;
      margin: 4px 0;
      display: block;
    }

    .message-document {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      background: #f0f0f0;
      border-radius: 8px;
      text-decoration: none;
      max-width: 260px;
    }

    .composer {
      background: white;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-top: 1px solid #e9ecef;
      flex-shrink: 0;
    }

    .composer-input {
      flex: 1;
      display: flex;
      align-items: center;
      background: var(--sidebar-bg);
      border-radius: 24px;
      padding: 8px 16px;
    }

    .composer-input input {
      flex: 1;
      border: none;
      background: none;
      outline: none;
      font-size: 14px;
    }

    .composer button {
      background: var(--whatsapp-green);
      border: none;
      color: white;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      cursor: pointer;
    }

    .file-preview {
      background: white;
      padding: 8px 20px;
      border-top: 1px solid #e9ecef;
      display: none;
      flex-shrink: 0;
    }

    .file-preview.show {
      display: block;
    }

    .typing-indicator {
      padding: 8px 20px;
      font-size: 12px;
      color: #667781;
      font-style: italic;
      flex-shrink: 0;
    }

 .media-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.95);
  display: none;
  z-index: 2000;
  overflow: auto; /* Add this - enables scrolling */
}

.media-modal.show {
  display: flex; /* Change from block to flex */
  align-items: center;
  justify-content: center;
}

.media-content {
  position: relative;
  width: 100%;
  min-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
}

.media-content img {
  max-width: 100%;
  width: auto;
  height: auto;
  max-height: 90vh; /* Limit height to viewport */
  object-fit: contain;
  display: block;
  margin: 0 auto;
  border-radius: 8px;
}

.media-content video {
  max-width: 100%;
  max-height: 90vh;
  width: auto;
  height: auto;
  display: block;
  margin: 0 auto;
  border-radius: 8px;
}

.modal-close {
  position: fixed;
  top: 20px;
  right: 20px;
  background: rgba(0,0,0,0.7);
  border: none;
  color: white;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  font-size: 24px;
  cursor: pointer;
  z-index: 2001;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.modal-close:hover {
  background: rgba(0,0,0,0.9);
}

    .loading, .empty-state {
      text-align: center;
      padding: 40px;
      color: #667781;
    }

    .notification {
      position: fixed;
      bottom: 20px;
      right: 20px;
      padding: 12px 20px;
      border-radius: 8px;
      color: white;
      z-index: 9999;
      animation: slideInRight 0.3s ease;
    }

    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .notification.success { background: var(--whatsapp-green); }
    .notification.error { background: #dc3545; }
    .notification.info { background: #17a2b8; }

    .load-older-container {
      display: flex;
      justify-content: center;
      margin: 16px 0;
      cursor: pointer;
    }

    .load-older-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      background: var(--whatsapp-green);
      color: white;
      border-radius: 24px;
      font-size: 13px;
      font-weight: 500;
    }

    .load-older-btn:hover {
      background: var(--whatsapp-teal);
    }

    .date-separator {
      text-align: center;
      margin: 16px 0;
    }

    .date-separator span {
      background: rgba(0,0,0,0.05);
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 11px;
      color: #667781;
    }

    .messages-container::-webkit-scrollbar {
      width: 6px;
    }
    .messages-container::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    .messages-container::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 3px;
    }
    .contact-list::-webkit-scrollbar {
      width: 6px;
    }
    .contact-list::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    .contact-list::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 3px;
    }
    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }
    .date-separator {
    text-align: center;
    margin: 16px 0;
}

.date-separator span {
    background: rgba(0,0,0,0.05);
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    color: #667781;
}
/* WhatsApp-style Document Bubble */
/* Document download button - make entire bubble clickable */
.document-bubble {
    max-width: 280px;
    background: #f0f0f0;
    border-radius: 12px;
    overflow: hidden;
    transition: background 0.2s;
    cursor: pointer;
}

.document-bubble:hover {
    background: #e5e5e5;
}

.document-content {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
}

.document-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 10px;
}

.document-icon i {
    font-size: 22px;
}

.document-details {
    flex: 1;
    min-width: 0;
}

.document-filename {
    font-size: 13px;
    font-weight: 500;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.document-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: 10px;
    color: #667781;
}

.document-download {
    flex-shrink: 0;
    color: #8696a0;
    font-size: 14px;
    padding: 6px;
    border-radius: 50%;
    transition: all 0.2s;
}

.document-bubble:hover .document-download i {
    color: var(--whatsapp-green);
}

.doc-text {
    margin-top: 6px;
    font-size: 13px;
    color: #111;
    word-break: break-word;
}

/* Sent message document bubble color */
.message-bubble.sent .document-bubble {
    background: rgba(220, 248, 198, 0.8);
}

.message-bubble.sent .document-bubble:hover {
    background: rgba(220, 248, 198, 1);
}
/* ============================================ */
/* MOBILE FIXES - Media elements inside bubbles */
/* ============================================ */

/* Ensure all media elements stay inside bubble on mobile */
@media (max-width: 768px) {
    /* Message bubble width on mobile */
    .message-bubble {
        max-width: 85%;
        min-width: 50px;
        padding: 6px 10px;
    }

    /* Image sizing */
    .message-image {
        max-width: 100%;
        max-height: 200px;
        width: auto;
        height: auto;
        object-fit: cover;
    }

    /* Video sizing */
    .message-video {
        max-width: 100%;
        max-height: 200px;
        width: auto;
        height: auto;
    }

    /* Audio player */
    .message-audio {
        width: 100%;
        max-width: 220px;
    }

    audio {
        width: 100%;
        max-width: 220px;
    }

    /* Document bubble */
    .document-bubble {
        max-width: 100%;
        min-width: 200px;
    }

    .document-content {
        gap: 8px;
        padding: 8px 10px;
    }

    .document-icon {
        width: 35px;
        height: 35px;
    }

    .document-icon i {
        font-size: 18px;
    }

    .document-filename {
        font-size: 12px;
    }

    .document-meta {
        font-size: 9px;
    }

    /* Date separator */
    .date-separator span {
        font-size: 10px;
        padding: 3px 8px;
    }

    /* Composer on mobile */
    .composer {
        padding: 8px 12px;
        gap: 8px;
    }

    .composer-input {
        padding: 6px 12px;
    }

    .composer-input input {
        font-size: 13px;
    }

    .composer button {
        width: 35px;
        height: 35px;
    }

    /* Chat header on mobile */
    .chat-header {
        padding: 10px 15px;
    }

    .chat-header-avatar {
        width: 35px;
        height: 35px;
        font-size: 14px;
    }

    .chat-header-name {
        font-size: 15px;
    }

    /* Message meta */
    .message-meta {
        font-size: 9px;
    }

    .message-time {
        font-size: 9px;
    }

    .message-tick {
        font-size: 11px;
    }
}

/* For extra small devices (phones below 480px) */
@media (max-width: 480px) {
    .message-bubble {
        max-width: 90%;
    }

    .message-image {
        max-height: 180px;
    }

    .message-video {
        max-height: 180px;
    }

    .document-bubble {
        min-width: 180px;
    }

    .document-filename {
        font-size: 11px;
    }

    .messages-container {
        padding: 12px;
        gap: 8px;
    }

    .date-separator {
        margin: 10px 0;
    }

    .date-separator span {
        font-size: 9px;
    }
}
/* File Preview */
    .file-preview {
      background: white;
      padding: 8px 20px;
      border-top: 1px solid #e9ecef;
      display: none;
      flex-shrink: 0;
    }

    .file-preview.show {
      display: block;
    }

    .preview-card {
      background: #f8f9fa;
      padding: 8px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
    }

    .preview-card i {
      font-size: 24px;
      color: var(--whatsapp-green);
    }

    .preview-info {
      flex: 1;
    }

    .preview-name {
      font-weight: 500;
      margin-bottom: 2px;
      word-break: break-word;
    }

    .preview-size {
      font-size: 11px;
      color: #667781;
    }

    .preview-cancel {
      background: none;
      border: none;
      cursor: pointer;
      color: #dc3545;
      font-size: 16px;
      padding: 4px;
    }

  </style>
</head>
<body>
  <div class="chat-container">
    <div class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <h4><i class="fab fa-whatsapp"></i>PSF Chats</h4>
      </div>
      <div class="chat-tabs">
        <div class="chat-tab active" data-filter="all" onclick="switchTab('all')">All</div>
        <div class="chat-tab" data-filter="unread" onclick="switchTab('unread')">
          Unread
          <span class="badge" id="unreadCountBadge" style="display: none;">0</span>
        </div>
      </div>
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search contacts..." autocomplete="off">
      </div>
      <div class="contact-list" id="contactList">
        <div class="loading">Loading contacts...</div>
      </div>
    </div>

    <div class="chat-area" id="chatArea" style="display: none;">
      <div class="chat-header">
        <button class="chat-header-back" id="backBtn"><i class="fas fa-arrow-left"></i></button>
        <div class="chat-header-avatar" id="headerAvatar">👤</div>
        <div class="chat-header-info">
          <div class="chat-header-name" id="headerName">Select a chat</div>
          <div class="chat-header-status" id="headerStatus"></div>
        </div>
      </div>

      <div class="messages-container" id="messagesContainer">
        <div class="empty-state">Select a contact to start chatting</div>
      </div>

      <div class="typing-indicator" id="typingIndicator" style="display: none;">Typing...</div>

      <div class="composer" style="display: none;">
        <div class="composer-input">
          <button id="attachBtn"><i class="fas fa-paperclip"></i></button>
          <input type="text" id="messageInput" placeholder="Type a message...">
        </div>
        <button id="sendBtn"><i class="fas fa-paper-plane"></i></button>
        <input type="file" id="mediaInput" style="display: none;" accept="image/*,video/*,audio/*,.pdf,.doc,.docx">
      </div>

      <div class="file-preview" id="filePreview">
        <div class="preview-card">
          <i class="fas fa-file"></i>
          <div class="preview-info">No file selected</div>
          <button class="preview-cancel" onclick="cancelFile()">✖</button>
        </div>
      </div>
    </div>
  </div>

  <div id="mediaModal" class="media-modal">
    <button class="modal-close" onclick="closeMediaModal()">×</button>
    <div id="mediaContent"></div>
  </div>

  <script>
    // Configuration
    const CSRF = document.querySelector('meta[name="csrf-token"]').content;
    let ws = null;
    let selectedMobile = null;
    let contacts = [];
    let messages = [];
    let isLoadingMessages = false;
    let hasMoreMessages = true;
    let lastMessageId = null;
    let reconnectAttempts = 0;
    let typingTimeout = null;
    let nextCursorDate = null;
    let initialLoadDone = false;
    let currentFilter = 'all';
    let totalUnreadCount = 0;
    let contactPage = 1;
    let isLoadingContacts = false;
    let hasMoreContacts = true;
    let pendingMessageIds = {};
    // DOM Elements
    const contactListEl = document.getElementById('contactList');
    const chatArea = document.getElementById('chatArea');
    const messagesContainer = document.getElementById('messagesContainer');
    const headerName = document.getElementById('headerName');
    const headerAvatar = document.getElementById('headerAvatar');
    const headerStatus = document.getElementById('headerStatus');
    const composer = document.querySelector('.composer');
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    const attachBtn = document.getElementById('attachBtn');
    const mediaInput = document.getElementById('mediaInput');
    const searchInput = document.getElementById('searchInput');
    const typingIndicator = document.getElementById('typingIndicator');
    const backBtn = document.getElementById('backBtn');
    const filePreview = document.getElementById('filePreview');

    // ============================================
    // WEBSOCKET CONNECTION
    // ============================================
    function showNotification(message, type = 'info') {
    // Remove existing notification
    const existing = document.querySelector('.notification');
    if (existing) existing.remove();

    // Create notification element
    const notification = document.createElement('div');
    notification.className = `notification ${type}`;
    notification.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'}"></i> ${message}`;
    document.body.appendChild(notification);

    // Auto remove after 3 seconds
    setTimeout(() => {
        notification.remove();
    }, 3000);
}
     async function downloadDocument(url, filename, event) {
        if (event) {
            event.stopPropagation();
        }

        try {
            showNotification(`Downloading ${filename}...`, 'info');

            const response = await fetch(url);
            if (!response.ok) throw new Error('Download failed');

            const blob = await response.blob();
            const blobUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(blobUrl);

            showNotification(`Downloaded ${filename} successfully!`, 'success');
        } catch (error) {
            console.error('Download error:', error);
            window.open(url, '_blank');
        }
    }
    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatTime(isoString) {
      const date = new Date(isoString);
      const now = new Date();
      const diff = now - date;
      if (diff < 86400000) {
        return date.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
      } else if (diff < 604800000) {
        return date.toLocaleDateString('en-IN', { weekday: 'short' });
      } else {
        return date.toLocaleDateString('en-IN', { day: '2-digit', month: '2-digit' });
      }
    }
function isSameDay(date1, date2) {
    return date1.getDate() === date2.getDate() &&
           date1.getMonth() === date2.getMonth() &&
           date1.getFullYear() === date2.getFullYear();
}

function formatMessageDate(date) {
    const today = new Date();
    const yesterday = new Date(today);
    yesterday.setDate(yesterday.getDate() - 1);

    const todayDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    const yesterdayDate = new Date(yesterday.getFullYear(), yesterday.getMonth(), yesterday.getDate());
    const msgDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());

    if (msgDate.getTime() === todayDate.getTime()) {
        return 'Today';
    } else if (msgDate.getTime() === yesterdayDate.getTime()) {
        return 'Yesterday';
    } else {
        // Format: "15 April 2024" or "15 April"
        const options = {
            day: 'numeric',
            month: 'long',
            year: date.getFullYear() !== today.getFullYear() ? 'numeric' : undefined
        };
        return date.toLocaleDateString('en-IN', options);
    }
}

function renderMessage(msg) {
    const isSent = msg.message_type === 'Sent';
    const time = new Date(msg.sent_at).toLocaleString('en-IN', {
        hour: '2-digit',
        minute: '2-digit',
        day: '2-digit',
        month: 'short',
        year: '2-digit'
    });

    let contentHtml = '';
    if (msg.content_type === 'image' && msg.media_file) {
        contentHtml = `<img src="${msg.media_file}" class="message-image" onclick="openMedia('${msg.media_file}', 'image')">`;
        if (msg.sent_text_message) {
            contentHtml += `<div class="message-text" style="margin-top: 8px;">${escapeHtml(msg.sent_text_message)}</div>`;
        }
    } else if (msg.content_type === 'video' && msg.media_file) {
        contentHtml = `<video class="message-video" onclick="openMedia('${msg.media_file}', 'video')"><source src="${msg.media_file}"></video>`;
        if (msg.sent_text_message) {
            contentHtml += `<div class="message-text" style="margin-top: 8px;">${escapeHtml(msg.sent_text_message)}</div>`;
        }
    } else if (msg.content_type === 'audio' && msg.media_file) {
        contentHtml = `<audio controls src="${msg.media_file}"></audio>`;
        if (msg.sent_text_message) {
            contentHtml += `<div class="message-text" style="margin-top: 8px;">${escapeHtml(msg.sent_text_message)}</div>`;
        }
    }
    else if (msg.content_type === 'document' && msg.media_file) {
    // Extract filename from URL
    let fileName = msg.media_file.split('/').pop().split('?')[0];
    fileName = decodeURIComponent(fileName);

    // Truncate long filename
    let displayName = fileName;
    if (fileName.length > 30) {
        const nameParts = fileName.split('.');
        const ext = nameParts.pop();
        const name = nameParts.join('.');
        displayName = name.substring(0, 25) + '...' + ext;
    }

    const fileExt = fileName.split('.').pop().toLowerCase();

    // Set icon based on file type
    let fileIcon = 'fa-file-pdf';
    let iconColor = '#dc4a2c';
    let fileTypeName = 'PDF';

    const fileTypes = {
        'doc': { icon: 'fa-file-word', color: '#2b579a', name: 'Word' },
        'docx': { icon: 'fa-file-word', color: '#2b579a', name: 'Word' },
        'xls': { icon: 'fa-file-excel', color: '#1e7145', name: 'Excel' },
        'xlsx': { icon: 'fa-file-excel', color: '#1e7145', name: 'Excel' },
        'ppt': { icon: 'fa-file-powerpoint', color: '#d35230', name: 'PowerPoint' },
        'pptx': { icon: 'fa-file-powerpoint', color: '#d35230', name: 'PowerPoint' },
        'jpg': { icon: 'fa-file-image', color: '#f39c12', name: 'Image' },
        'jpeg': { icon: 'fa-file-image', color: '#f39c12', name: 'Image' },
        'png': { icon: 'fa-file-image', color: '#f39c12', name: 'Image' },
        'gif': { icon: 'fa-file-image', color: '#f39c12', name: 'Image' },
        'mp4': { icon: 'fa-file-video', color: '#27ae60', name: 'Video' },
        'mov': { icon: 'fa-file-video', color: '#27ae60', name: 'Video' },
        'mp3': { icon: 'fa-file-audio', color: '#e67e22', name: 'Audio' },
        'wav': { icon: 'fa-file-audio', color: '#e67e22', name: 'Audio' },
        'zip': { icon: 'fa-file-archive', color: '#f1c40f', name: 'Archive' },
        'rar': { icon: 'fa-file-archive', color: '#f1c40f', name: 'Archive' },
        'txt': { icon: 'fa-file-alt', color: '#3498db', name: 'Text' }
    };

    if (fileTypes[fileExt]) {
        fileIcon = fileTypes[fileExt].icon;
        iconColor = fileTypes[fileExt].color;
        fileTypeName = fileTypes[fileExt].name;
    }

    contentHtml = `
        <div class="document-bubble" onclick="downloadDocument('${msg.media_file}', '${escapeHtml(fileName)}', event)">
            <div class="document-content">
                <div class="document-icon">
                    <i class="fas ${fileIcon}" style="color: ${iconColor};"></i>
                </div>
                <div class="document-details">
                    <div class="document-filename">${escapeHtml(displayName)}</div>
                    <div class="document-meta">
                        <span class="document-type">${fileTypeName}</span>
                    </div>
                </div>
                <div class="document-download">
                    <i class="fas fa-download"></i>
                </div>
            </div>
        </div>
        ${msg.sent_text_message ? `<div class="doc-text">${escapeHtml(msg.sent_text_message)}</div>` : ''}
    `;
}
    else {
        contentHtml = `<div class="message-text">${escapeHtml(msg.sent_text_message || '')}</div>`;
    }

    // In renderMessage function, replace the tickHtml section with:
let tickHtml = '';
if (isSent) {
    const msgId = msg.message_id || msg.id || '';
    if (msg.status === 'Read')
        tickHtml = `<span class="message-tick read" data-msg-id="${msgId}">✓✓</span>`;
    else if (msg.status === 'Delivered')
        tickHtml = `<span class="message-tick delivered" data-msg-id="${msgId}">✓✓</span>`;
    else
        tickHtml = `<span class="message-tick sent" data-msg-id="${msgId}">✓</span>`;
}

    return `
        <div class="message-row ${isSent ? 'sent' : 'received'}">
            <div class="message-bubble ${isSent ? 'sent' : 'received'}">
                ${contentHtml}
                <div class="message-meta">
                    <span class="message-time">${time}</span>
                    ${tickHtml}
                </div>
            </div>
        </div>
    `;
}

function renderMessages(messagesData, hasMore, nextCursorDateParam, isInitial = false) {
    if (messagesData.length === 0 && messages.length === 0) {
        messagesContainer.innerHTML = '<div class="empty-state">No messages yet</div>';
        return;
    }

    hasMoreMessages = hasMore;
    nextCursorDate = nextCursorDateParam;

    const sortedMessages = [...messagesData].sort((a, b) => new Date(a.sent_at) - new Date(b.sent_at));

    let newMessages = [];
    if (isInitial || messages.length === 0) {
        newMessages = sortedMessages;
    } else {
        newMessages = [...sortedMessages, ...messages];
    }

    // Build messages with date separators
    let lastDate = null;
    let html = '';

    for (const msg of newMessages) {
        const msgDate = new Date(msg.sent_at);
        const currentDateLabel = formatMessageDate(msgDate);

        if (lastDate !== currentDateLabel) {
            html += `<div class="date-separator"><span>${currentDateLabel}</span></div>`;
            lastDate = currentDateLabel;
        }

        html += renderMessage(msg);
    }

    if (isInitial || messages.length === 0) {
        messages = newMessages;
        messagesContainer.innerHTML = html;
        if (hasMoreMessages) addLoadOlderButton();
        else removeLoadOlderButton();
        scrollToBottom();
    } else {
        // ---- LOADING OLDER MESSAGES - preserve scroll correctly ----
        const oldScrollHeight = messagesContainer.scrollHeight;
        const oldScrollTop = messagesContainer.scrollTop;

        // Temporarily remove the "Load Older" button to avoid its height in calculations
        const oldButton = document.getElementById('loadOlderButton');
        const buttonHeight = oldButton ? oldButton.offsetHeight : 0;
        if (oldButton) oldButton.remove();

        messages = newMessages;
        messagesContainer.innerHTML = html;

        // ✅ FIX: Re-add the button AFTER setting innerHTML
        if (hasMoreMessages) {
            addLoadOlderButton();  // ← THIS WAS MISSING!
        } else {
            removeLoadOlderButton();  // ← THIS WAS MISSING!
        }

        const newScrollHeight = messagesContainer.scrollHeight;
        // Amount of new content added above the previous viewport
        const addedHeight = newScrollHeight - (oldScrollHeight - buttonHeight);
        messagesContainer.scrollTop = oldScrollTop + addedHeight;
    }
    isLoadingMessages = false;
}

// Updated renderMessage function with date+time format


// Updated appendMessage function for new messages (adds date separator when needed)
function appendMessage(msg) {
    const wasAtBottom = messagesContainer.scrollHeight - messagesContainer.scrollTop - messagesContainer.clientHeight < 100;

    // Check if we need to add a date separator
    let needDateSeparator = false;
    let newDateLabel = null;

    if (messages.length > 0) {
        const lastMsg = messages[messages.length - 1];
        const lastMsgDate = new Date(lastMsg.sent_at);
        const newMsgDate = new Date(msg.sent_at);

        if (!isSameDay(lastMsgDate, newMsgDate)) {
            needDateSeparator = true;
            newDateLabel = formatMessageDate(newMsgDate);
        }
    } else {
        needDateSeparator = true;
        newDateLabel = formatMessageDate(new Date(msg.sent_at));
    }

    // Add to messages array
    messages.push(msg);

    // Build new HTML
    let newHtml = '';
    if (needDateSeparator) {
        newHtml = `<div class="date-separator"><span>${newDateLabel}</span></div>`;
    }
    newHtml += renderMessage(msg);

    // Add to DOM
    messagesContainer.insertAdjacentHTML('beforeend', newHtml);

    // Store message ID on the row for easy lookup
    const lastRow = messagesContainer.lastElementChild;
    if (lastRow && msg.message_id) {
        lastRow.setAttribute('data-message-id', msg.message_id);
        const tickSpan = lastRow.querySelector('.message-tick');
        if (tickSpan) {
            tickSpan.setAttribute('data-msg-id', msg.message_id);
        }
    }

    if (wasAtBottom) {
        scrollToBottom();
    }
}


function updateMessageTickInDOM(tempId, realId, status) {
    // Try to find by both IDs
    let tickSpan = document.querySelector(`.message-tick[data-msg-id="${tempId}"]`);
    if (!tickSpan && realId) {
        tickSpan = document.querySelector(`.message-tick[data-msg-id="${realId}"]`);
    }

    // If not found by ID, search through all sent messages
    if (!tickSpan) {
        const sentRows = document.querySelectorAll('.message-row.sent');
        for (const row of sentRows) {
            const tick = row.querySelector('.message-tick');
            if (tick) {
                // Check if this is the most recent sent message
                if (!tickSpan) {
                    tickSpan = tick;
                }
            }
        }
        if (tickSpan) {
            console.log('Using newest sent message as fallback');
        }
    }

    if (tickSpan) {
        // Store the real ID for future updates
        if (realId) {
            tickSpan.setAttribute('data-msg-id', realId);
        }

        if (status === 'Read') {
            tickSpan.textContent = '✓✓';
            tickSpan.className = 'message-tick read';
            tickSpan.style.color = '#34B7F1';
            console.log('✅ Updated to READ (blue double tick)');
        } else if (status === 'Delivered') {
            tickSpan.textContent = '✓✓';
            tickSpan.className = 'message-tick delivered';
            tickSpan.style.color = '#8696a0';
            console.log('✅ Updated to DELIVERED (grey double tick)');
        } else if (status === 'Sent') {
            tickSpan.textContent = '✓';
            tickSpan.className = 'message-tick sent';
            tickSpan.style.color = '#8696a0';
            console.log('✅ Updated to SENT (single tick)');
        }
    } else {
        console.warn('⚠️ Could not find tick span in DOM');
    }
}

 function updateMessageTickImproved(messageId, status) {
    console.log(`🔄 Updating tick for ${messageId} to ${status}`);

    // Check for mapped ID
    let realMessageId = messageId;
    if (window.pendingMessageIds && window.pendingMessageIds[messageId]) {
        realMessageId = window.pendingMessageIds[messageId];
        console.log(`📌 Mapped to real ID: ${realMessageId}`);
    }

    // Update in messages array
    let updatedMessage = null;
    for (let i = 0; i < messages.length; i++) {
        const msg = messages[i];
        const msgId = msg.message_id || msg.id;

        if (msgId === realMessageId || msgId === messageId || msg.id == messageId || msg.id == realMessageId) {
            msg.status = status;
            updatedMessage = msg;
            console.log(`✅ Updated message at index ${i} to ${status}, Message ID: ${msg.message_id}`);
            break;
        }
    }

    // If still not found, update the most recent sent message
    if (!updatedMessage && messages.length > 0) {
        for (let i = messages.length - 1; i >= 0; i--) {
            if (messages[i].message_type === 'Sent') {
                messages[i].status = status;
                updatedMessage = messages[i];
                console.log(`✅ Updated last sent message to ${status}`);
                break;
            }
        }
    }

    // ========== CRITICAL: Force find and update the tick in DOM ==========

    // Method 1: Try to find by data-msg-id
    let tickSpan = document.querySelector(`.message-tick[data-msg-id="${realMessageId}"]`);
    if (!tickSpan) {
        tickSpan = document.querySelector(`.message-tick[data-msg-id="${messageId}"]`);
    }

    // Method 2: Find the last sent message row and get its tick
    if (!tickSpan) {
        const allMessageRows = document.querySelectorAll('.message-row');
        console.log(`🔍 Searching through ${allMessageRows.length} message rows`);

        // Loop backwards to find the last sent message
        for (let i = allMessageRows.length - 1; i >= 0; i--) {
            const row = allMessageRows[i];
            if (row.classList.contains('sent')) {
                tickSpan = row.querySelector('.message-tick');
                if (tickSpan) {
                    console.log(`✅ Found tick in last sent message row (index ${i})`);
                    break;
                }
            }
        }
    }

    // Method 3: Direct search for any message-tick in sent messages
    if (!tickSpan) {
        const sentTicks = document.querySelectorAll('.message-row.sent .message-tick');
        if (sentTicks.length > 0) {
            tickSpan = sentTicks[sentTicks.length - 1];
            console.log(`✅ Using last sent tick from ${sentTicks.length} total ticks`);
        }
    }

    // Update the tick if found
    if (tickSpan) {
        console.log(`🎯 Found tick, current text: "${tickSpan.textContent}", status: ${status}`);

        if (status === 'Read') {
            tickSpan.textContent = '✓✓';
            tickSpan.className = 'message-tick read';
            tickSpan.style.color = '#34B7F1';
            tickSpan.style.fontWeight = 'bold';
            console.log('✅ Updated to READ (blue double tick)');
        } else if (status === 'Delivered') {
            tickSpan.textContent = '✓✓';
            tickSpan.className = 'message-tick delivered';
            tickSpan.style.color = '#25D366';
            tickSpan.style.fontWeight = 'bold';
            console.log('✅ Updated to DELIVERED (green double tick)');
        } else if (status === 'Sent') {
            tickSpan.textContent = '✓';
            tickSpan.className = 'message-tick sent';
            tickSpan.style.color = '#8696a0';
            tickSpan.style.fontWeight = 'normal';
            console.log('✅ Updated to SENT (single tick)');
        }

        // Force a reflow to ensure the change is visible
        tickSpan.style.display = 'inline-block';
        tickSpan.offsetHeight; // Force reflow

        // Store the real ID for future updates
        if (realMessageId && realMessageId !== '') {
            tickSpan.setAttribute('data-msg-id', realMessageId);
        }

        console.log(`🎯 Final tick text: "${tickSpan.textContent}", class: "${tickSpan.className}"`);
    } else {
        console.error('❌ Could NOT find any tick span to update!');
        console.log('Available message IDs in array:', messages.map(m => m.message_id || m.id));

        // Force refresh as last resort
        if (selectedMobile) {
            console.log('🔄 Forcing message refresh...');
            setTimeout(() => {
                sendWS({ type: 'get_messages', mobile: selectedMobile, limit: 30 });
            }, 500);
        }
    }
}
// New function to update a specific message's tick by index
function updateSpecificMessageTick(messageIndex, status) {
    console.log(`🔍 Updating tick for message at index ${messageIndex} to ${status}`);

    // Get all sent message rows
    const messageRows = document.querySelectorAll('.message-row.sent');
    console.log(`📊 Found ${messageRows.length} sent message rows in DOM`);

    // The messages array is oldest first, DOM is also oldest first
    // So index should match
    if (messageIndex < messageRows.length) {
        const targetRow = messageRows[messageIndex];
        let tickSpan = targetRow.querySelector('.message-tick');

        if (tickSpan) {
            // Update the tick
            if (status === 'Read') {
                tickSpan.textContent = '✓✓';
                tickSpan.className = 'message-tick read';
                tickSpan.style.color = '#34B7F1';
                tickSpan.style.fontWeight = 'bold';
                console.log('✅ Updated to READ (blue double tick)');
            } else if (status === 'Delivered') {
                tickSpan.textContent = '✓✓';
                tickSpan.className = 'message-tick delivered';
                tickSpan.style.color = '#25D366';
                tickSpan.style.fontWeight = 'bold';
                console.log('✅ Updated to DELIVERED (green double tick)');
            } else if (status === 'Sent') {
                tickSpan.textContent = '✓';
                tickSpan.className = 'message-tick sent';
                tickSpan.style.color = '#8696a0';
                tickSpan.style.fontWeight = 'normal';
                console.log('✅ Updated to SENT (single tick)');
            }

            // Store the message ID for future reference
            if (messages[messageIndex] && messages[messageIndex].message_id) {
                tickSpan.setAttribute('data-msg-id', messages[messageIndex].message_id);
            }
        } else {
            console.warn(`⚠️ No tick span found in row ${messageIndex}`);
        }
    } else {
        console.warn(`⚠️ Message index ${messageIndex} out of range. DOM has ${messageRows.length} rows`);
        // Try to find by content as last resort
        if (messages[messageIndex]) {
            const msgText = messages[messageIndex].sent_text_message;
            for (const row of messageRows) {
                const textDiv = row.querySelector('.message-text');
                if (textDiv && textDiv.textContent === msgText) {
                    const tickSpan = row.querySelector('.message-tick');
                    if (tickSpan) {
                        if (status === 'Delivered') {
                            tickSpan.textContent = '✓✓';
                            tickSpan.className = 'message-tick delivered';
                            tickSpan.style.color = '#25D366';
                        } else if (status === 'Read') {
                            tickSpan.textContent = '✓✓';
                            tickSpan.className = 'message-tick read';
                            tickSpan.style.color = '#34B7F1';
                        }
                        console.log('✅ Updated tick by text match');
                        break;
                    }
                }
            }
        }
    }
}

    function connectWebSocket() {
      if (ws && ws.readyState === WebSocket.OPEN) return;
      const scheme = location.protocol === 'https:' ? 'wss' : 'ws';
      ws = new WebSocket(`${scheme}://${location.host}/ws/chat_spl/`);

      ws.onopen = () => {
        console.log('WebSocket connected');
        reconnectAttempts = 0;
        showNotification('Connected to chat server', 'success');
        loadContacts();
      };

      ws.onmessage = (e) => {
        try {
          handleWebSocketMessage(JSON.parse(e.data));
        } catch (err) {
          console.error('WebSocket parse error:', err);
        }
      };

      ws.onclose = () => {
        console.log('WebSocket disconnected');
        showNotification('Disconnected from server, reconnecting...', 'info');

        setTimeout(() => {
          if (reconnectAttempts < 10) {
            reconnectAttempts++;
            connectWebSocket();
          }
        }, 3000);
      };
       ws.onerror = (error) => {
        console.error('WebSocket error:', error);
        showNotification('Connection error', 'error');
      };

    }

    function sendWS(data) {
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify(data));
      }
       else {
        console.warn('WebSocket not connected');
      }

    }

    // ============================================
    // TAB SWITCH FUNCTION
    // ============================================
    function switchTab(filter) {
      if (currentFilter === filter) return;
      currentFilter = filter;

      document.querySelectorAll('.chat-tab').forEach(tab => {
        if (tab.dataset.filter === filter) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      contactPage = 1;
      contacts = [];
      hasMoreContacts = true;
      contactListEl.innerHTML = '<div class="loading">Loading contacts...</div>';
      loadContacts();
    }

    // ============================================
    // CONTACTS WITH INFINITE SCROLL
    // ============================================
    function loadContacts(page = 1) {
      if (isLoadingContacts) return;
      isLoadingContacts = true;
      sendWS({ type: 'get_contacts', page: page, filter: currentFilter });
    }

    function searchContacts(query) {
      contactPage = 1;
      contacts = [];
      hasMoreContacts = true;
      sendWS({ type: 'search_contacts', q: query, filter: currentFilter });
    }

    function renderContacts(contactsData, replace = true, unreadCount = 0, hasMore = false, currentPage = 1) {
      isLoadingContacts = false;

      if (replace) {
        contacts = contactsData;
      } else {
        contacts = [...contacts, ...contactsData];
      }

      totalUnreadCount = unreadCount;
      const badge = document.getElementById('unreadCountBadge');
      if (badge) {
        if (totalUnreadCount > 0) {
          badge.style.display = 'inline';
          badge.textContent = totalUnreadCount;
        } else {
          badge.style.display = 'none';
        }
      }

      if (contacts.length === 0) {
        let emptyMessage = currentFilter === 'unread' ? 'No unread messages' : 'No contacts found';
        contactListEl.innerHTML = `<div class="empty-state">${emptyMessage}</div>`;
        return;
      }

      contactListEl.innerHTML = contacts.map(contact => `
        <div class="contact-item ${selectedMobile === contact.mobile ? 'active' : ''}"
             data-mobile="${contact.mobile}"
             onclick="selectContact('${contact.mobile.replace(/'/g, "\\'")}')">
          <div class="contact-avatar">${contact.mobile.slice(-2)}</div>
          <div class="contact-info">
            <div class="contact-name">${escapeHtml(contact.mobile)}</div>
            <div class="contact-last-msg">${escapeHtml(contact.last_msg || '')}</div>
          </div>
          <div class="contact-meta">
            ${contact.last_time ? `<div class="contact-time">${formatTime(contact.last_time)}</div>` : ''}
            ${contact.unread > 0 ? `<div class="unread-badge">${contact.unread}</div>` : ''}
          </div>
        </div>
      `).join('');

      if (hasMore) {
        addContactsLoadingIndicator();
      } else {
        removeContactsLoadingIndicator();
      }

      hasMoreContacts = hasMore;
      contactPage = currentPage;
    }

    function addContactsLoadingIndicator() {
      removeContactsLoadingIndicator();
      const loader = document.createElement('div');
      loader.id = 'contactsLoadingIndicator';
      loader.className = 'contacts-loading';
      loader.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading more contacts...';
      contactListEl.appendChild(loader);
    }

    function removeContactsLoadingIndicator() {
      const existing = document.getElementById('contactsLoadingIndicator');
      if (existing) existing.remove();
    }

    function handleContactsScroll() {
      if (!hasMoreContacts || isLoadingContacts) return;

      const scrollTop = contactListEl.scrollTop;
      const scrollHeight = contactListEl.scrollHeight;
      const clientHeight = contactListEl.clientHeight;

      if (scrollTop + clientHeight >= scrollHeight - 100) {
        loadContacts(contactPage + 1);
      }
    }

    function updateContactInList(contact) {
      const index = contacts.findIndex(c => c.mobile === contact.mobile);
      if (index !== -1) {
        contacts[index] = { ...contacts[index], ...contact };
      } else {
        contacts.unshift(contact);
        hasMoreContacts = true;
      }
      contacts.sort((a, b) => new Date(b.last_time) - new Date(a.last_time));
      renderContacts(contacts, true, totalUnreadCount, hasMoreContacts, contactPage);
    }

    function updateContactStatus(mobile, status) {
      const index = contacts.findIndex(c => c.mobile === mobile);
      if (index !== -1) {
        contacts[index].last_status = status;
        renderContacts(contacts, true, totalUnreadCount, hasMoreContacts, contactPage);
      }
    }

    // ============================================
    // SELECT CONTACT
    // ============================================
function selectContact(mobile) {
      console.log('🟢 ========== SELECT CONTACT ==========');
  console.log('🟢 Mobile:', mobile);
      if (selectedMobile === mobile) return;
      selectedMobile = mobile;

      document.querySelectorAll('.contact-item').forEach(el => {
        if (el.dataset.mobile === mobile) {
          el.classList.add('active');
        } else {
          el.classList.remove('active');
        }
      });

      if (window.innerWidth <= 768) {
        document.getElementById('sidebar').classList.add('hide');
      }

      chatArea.style.display = 'flex';
      composer.style.display = 'flex';
      headerName.textContent = mobile;
      headerAvatar.textContent = mobile.slice(-2);
      // headerStatus.textContent = 'Online';

      messages = [];
      hasMoreMessages = true;
      isLoadingMessages = false;
      nextCursorDate = null;
      initialLoadDone = false;
      messagesContainer.innerHTML = '<div class="loading"><i class="fas fa-spinner fa-spin"></i> Loading messages...</div>';

      sendWS({ type: 'join', mobile: mobile });
      console.log('📤 Sending get_messages request for:', mobile);
      sendWS({ type: 'get_messages', mobile: mobile, limit: 30 });
      // Also try direct REST API as fallback
        window.hasMarkedRead = false;

  setTimeout(async () => {
    if (messages.length === 0 && messagesContainer.innerHTML.includes('Loading')) {
      console.log('⚠️ No messages via WebSocket, trying REST API...');
      try {
        const response = await fetch(`/splcases_app/api/contact-messages3/?mobile=${encodeURIComponent(mobile)}`);
        const data = await response.json();
        console.log('REST API response:', data);
        if (data.messages && data.messages.length > 0) {
          renderMessages(data.messages, false, null, true);
        }
      } catch (err) {
        console.error('REST API failed:', err);
      }
    }
  }, 3000);

    }

    // Setup scroll to mark as read (only when user actually sees messages)
function setupScrollToMarkRead() {
    messagesContainer.addEventListener('scroll', function() {
        // Check if user has scrolled to bottom (within 100px)
        const isAtBottom = messagesContainer.scrollHeight - messagesContainer.scrollTop - messagesContainer.clientHeight < 100;

        if (isAtBottom && selectedMobile && !window.hasMarkedRead) {
            window.hasMarkedRead = true;
            console.log('📖 User scrolled to bottom, marking messages as read');
            sendWS({ type: 'mark_read', mobile: selectedMobile });

            // Update UI for all delivered ticks to read ticks
            const allDeliveredTicks = document.querySelectorAll('.message-tick.delivered');
            allDeliveredTicks.forEach(tick => {
                tick.textContent = '✓✓';
                tick.className = 'message-tick read';
                tick.style.color = '#34B7F1';
                tick.style.fontWeight = 'bold';
            });
        }
    });
}

    // MESSAGES
    // ============================================

    // Helper function to check if two dates are the same day
// Helper function to check if two dates are the same day

// Helper function to format date like WhatsApp


// Updated renderMessages function with date separators




// Add this new function for DOM tick updates


// Add this new handler for message ID updates
// Add this function - handles when temp message ID gets replaced with real WhatsApp ID
function handleMessageIdUpdate(data) {
    console.log(`🔄 Updating message ID: ${data.old_id} -> ${data.new_id}`);

    if (!window.pendingMessageIds) {
        window.pendingMessageIds = {};
    }
    window.pendingMessageIds[data.old_id] = data.new_id;

    // Update in messages array
    for (let i = 0; i < messages.length; i++) {
        if (messages[i].id == data.old_id || messages[i].message_id == data.old_id) {
            messages[i].message_id = data.new_id;
            console.log(`✅ Updated message ID in array at index ${i}`);
            break;
        }
    }

    // Update DOM
    let tickSpan = document.querySelector(`.message-tick[data-msg-id="${data.old_id}"]`);
    if (tickSpan) {
        tickSpan.setAttribute('data-msg-id', data.new_id);
        console.log('✅ Updated tick data-msg-id in DOM');
    }

    let messageRow = document.querySelector(`.message-row[data-message-id="${data.old_id}"]`);
    if (messageRow) {
        messageRow.setAttribute('data-message-id', data.new_id);
        console.log('✅ Updated message row data attribute');
    }
}

    function addLoadOlderButton() {
      removeLoadOlderButton();
      const loadButton = document.createElement('div');
      loadButton.id = 'loadOlderButton';
      loadButton.className = 'load-older-container';
      loadButton.innerHTML = `<div class="load-older-btn"><i class="fas fa-chevron-up"></i><span>Load Older Messages</span></div>`;
      loadButton.onclick = loadOlderMessages;
      if (messagesContainer.firstChild) {
        messagesContainer.insertBefore(loadButton, messagesContainer.firstChild);
      } else {
        messagesContainer.appendChild(loadButton);
      }
    }

    function removeLoadOlderButton() {
      const existing = document.getElementById('loadOlderButton');
      if (existing) existing.remove();
    }

    function loadOlderMessages() {
    if (isLoadingMessages || !hasMoreMessages) return;
    
    // ✅ FIX: Use nextCursorDate, NOT before_date
    if (!nextCursorDate) {
        console.warn('⚠️ No nextCursorDate available – cannot load older messages');
        return;
    }
    
    isLoadingMessages = true;
    const loadButton = document.getElementById('loadOlderButton');
    if (loadButton) {
        loadButton.innerHTML = `<div class="load-older-btn loading"><i class="fas fa-spinner fa-spin"></i><span>Loading...</span></div>`;
        loadButton.onclick = null;
    }
    sendWS({ type: 'get_messages', mobile: selectedMobile, before_date: nextCursorDate, limit: 30 });
}

    function scrollToBottom() {
      setTimeout(() => messagesContainer.scrollTop = messagesContainer.scrollHeight, 100);
    }

    // ============================================
    // SEND MESSAGE
    // ============================================
    async function sendMessage() {
      const text = messageInput.value.trim();
      const file = mediaInput.files[0];

      if (!selectedMobile) {
        showNotification('Select a contact first', 'error');
        return;
      }
      if (!text && !file){
        showNotification('Enter a message or select a file', 'error');
        return;
      }
      // Check file size before uploading
    if (file) {
        const fileSizeMB = file.size / (1024 * 1024);
        const fileType = file.type.split('/')[0];

        let maxSize = 16; // default for video
        if (fileType === 'image') maxSize = 5;
        if (fileType === 'video') maxSize = 16;
        if (fileType === 'audio') maxSize = 16;

        if (fileSizeMB > maxSize) {
            showNotification(`File too large! ${fileType} must be under ${maxSize}MB. Yours is ${fileSizeMB.toFixed(2)}MB`, 'error');
            mediaInput.value = '';
            cancelFile();
            return;
        }
      }

      const originalBtnHtml = sendBtn.innerHTML;
      sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
      sendBtn.disabled = true;

      try {
        if (file) {
          const formData = new FormData();
          formData.append('mobile', selectedMobile);
          formData.append('text', text);
          formData.append('media', file);
          showNotification(`Uploading ${file.name} (${(file.size / (1024*1024)).toFixed(2)}MB)...`, 'info');


          const response = await fetch('/messaging2/api/send-reply2/', {
            method: 'POST',
            headers: { 'X-CSRFToken': CSRF },
            body: formData
          });
          const result = await response.json();
          if (result.status === 'ok') {
              showNotification('Message sent successfully!', 'success');

            messageInput.value = '';
            mediaInput.value = '';
            cancelFile();
          }
        } else if (text) {
          sendWS({ type: 'send_message', mobile: selectedMobile, text: text, content_type: 'text' });
          messageInput.value = '';
          showNotification('Message sent!', 'success');
        }
      } catch (error) {
        console.error('Send error:', error);
        showNotification(`Error: ${error.message}`, 'error');
      } finally {
        sendBtn.innerHTML = originalBtnHtml;
        sendBtn.disabled = false;
      }
    }

    function onTyping() {
      if (!selectedMobile) return;
      sendWS({ type: 'typing', mobile: selectedMobile, state: true });
      clearTimeout(typingTimeout);
      typingTimeout = setTimeout(() => {
        sendWS({ type: 'typing', mobile: selectedMobile, state: false });
      }, 1000);
    }

    function cancelFile() {
      mediaInput.value = '';
      filePreview.classList.remove('show');
  document.querySelector('.preview-info').textContent = 'No file selected';

    }

    // ============================================
    // MEDIA & UTILITIES
    // ============================================
 function openMedia(src, type) {
  const modal = document.getElementById('mediaModal');
  const content = document.getElementById('mediaContent');

  if (type === 'image') {
    content.innerHTML = `<img src="${src}" style="max-width: 100%; width: auto; height: auto; max-height: 90vh; object-fit: contain;">`;
  } else {
    content.innerHTML = `<video src="${src}" controls autoplay style="max-width: 100%; max-height: 90vh;"></video>`;
  }

  modal.classList.add('show');
  // Reset scroll position to top when opening
  modal.scrollTop = 0;
}
    function closeMediaModal() {
      document.getElementById('mediaModal').classList.remove('show');
      document.getElementById('mediaContent').innerHTML = '';
    }



    // ============================================
    // HANDLE WEBSOCKET MESSAGES
    // ============================================
    function handleWebSocketMessage(data) {
      console.log('📨 WebSocket message received:', data.type);

      switch (data.type) {
        case 'contacts.page':
          renderContacts(data.contacts, data.page === 1, data.unread_count, data.has_more, data.page);
          break;
case 'messages.page':
    console.log('📥 ========== MESSAGES.PAGE RECEIVED ==========');
    if (data.mobile === selectedMobile) {
        // ✅ CRITICAL: Update these variables
        hasMoreMessages = data.has_more;
        nextCursorDate = data.next_cursor_date || null;
        
        console.log(`📥 has_more from server: ${hasMoreMessages}`);
        console.log(`📥 next_cursor_date: ${nextCursorDate}`);

        if (data.messages && data.messages.length > 0) {
            renderMessages(data.messages, data.has_more, data.next_cursor_date, data.is_initial === true || messages.length === 0);
        } else {
            messagesContainer.innerHTML = '<div class="empty-state">No messages found</div>';
        }
    }
    break;
    
        case 'new.message':
          if (data.message.mobile === selectedMobile) {
            appendMessage(data.message);
          }
          updateContactInList(data.message);
          break;

        case 'delivery.update':
          console.log('📬 Delivery update received:', data.message_id, data.status);
          updateMessageTickImproved(data.message_id, data.status);
          if (data.mobile) updateContactStatus(data.mobile, data.status);
          break;

        case 'unread.update':
          if (data.unread_count !== undefined) {
            totalUnreadCount = data.unread_count;
            const badge = document.getElementById('unreadCountBadge');
            if (badge) {
              if (totalUnreadCount > 0) {
                badge.style.display = 'inline';
                badge.textContent = totalUnreadCount;
              } else {
                badge.style.display = 'none';
              }
            }
            if (currentFilter === 'unread') loadContacts(1);
          }
          break;

        case 'contact.update':
          if (data.contact) {
            const existingContact = contacts.find(c => c.mobile === data.contact.mobile);
            if (existingContact && !data.contact.last_time) {
              data.contact.last_time = existingContact.last_time;
            }
            updateContactInList(data.contact);
          }
          break;

        case 'typing':
          if (data.mobile === selectedMobile) {
            typingIndicator.style.display = data.state ? 'block' : 'none';
          }
          break;

        case 'joined':
          console.log('Joined chat:', data.mobile);
          break;

        case 'marked_read':
          console.log('Marked read:', data.mobile);
          break;
          case 'update.message_id':
            console.log('📌 Message ID update received:', data);
    handleMessageIdUpdate(data);
    break;

        case 'error':
          console.error('WebSocket error:', data.message);
          showNotification(data.message, 'error');
          break;
      }
    }

    // ============================================
    // EVENT LISTENERS
    // ============================================
    sendBtn.onclick = sendMessage;
    messageInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') sendMessage();
    });
    messageInput.addEventListener('input', onTyping);
    attachBtn.onclick = () => mediaInput.click();
    backBtn.onclick = () => {
      document.getElementById('sidebar').classList.remove('hide');
      chatArea.style.display = 'none';
    };

    mediaInput.addEventListener('change', (e) => {
  const file = e.target.files[0];

  if (file) {
    filePreview.classList.add('show');

    // 🔥 ADD THIS LINE
    document.querySelector('.preview-info').textContent = file.name;
  }
});

    searchInput.addEventListener('input', (e) => {
      clearTimeout(window.searchTimeout);
      window.searchTimeout = setTimeout(() => {
        if (e.target.value.trim()) {
          searchContacts(e.target.value.trim());
        } else {
          contactPage = 1;
          contacts = [];
          hasMoreContacts = true;
          loadContacts(1);
        }
      }, 300);
    });

    contactListEl.addEventListener('scroll', handleContactsScroll);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMediaModal();
    });

    document.getElementById('mediaModal').addEventListener('click', function(e) {
      if (e.target === this) closeMediaModal();
    });

    connectWebSocket();
    setupScrollToMarkRead();
  </script>
</body>
</html>

